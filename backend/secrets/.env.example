# Copy this file to .env and fill in your private credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Keep true for the local SRM demo; set false for Copernicus-backed retrieval.
DEMO_MODE=true

# Super-resolution Mapping Configuration
# Keep checkpoints outside Git. The official checkpoint downloads automatically when absent.
SRM_MODEL_PATH=
SRM_CHECKPOINT_URL=https://storage.googleapis.com/satlas-satellite-super-resolution/esrgan_1S2.pth
SRM_USE_BASELINE=false
# Optional Sentinel Hub instance. Without this, live mode uses the authenticated CDSE product fallback.
SH_INSTANCE_ID=
SRM_TILE_SIZE=32
SRM_TILE_OVERLAP=8
SRM_BATCH_SIZE=1
